<?xml version="1.0" encoding="utf-8"?>
<!--
  Marca do splash. O PNG e branco puro e o desenho ocupa 86% do raio do canvas,
  entao ele precisa ser menor que a area de 288dp que o sistema reserva: nessa
  medida o recorte circular aplicado no Android 6..11 comeria os cantos.
  A 208dp o raio da marca fica em ~89dp, dentro do circulo seguro de 96dp.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="208dp"
        android:height="208dp"
        android:drawable="@drawable/itasuper_brand_mark_white"
        android:gravity="center" />
</layer-list>
